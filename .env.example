# ==========================================
# Expense Tracker - Environment Variables
# ==========================================

# ------------------------------------------
# Frontend Variables (e.g. Vercel deployment)
# ------------------------------------------
# Configurable API base URL:
# Local dev: http://localhost:3000
# Production: Your Render backend URL
VITE_API_URL=https://expensetracker2-0-jl02.onrender.com
VITE_BACKEND_URL=https://expensetracker2-0-jl02.onrender.com

# ------------------------------------------
# Backend Variables (e.g. Render deployment)
# ------------------------------------------
PORT=3000
NODE_ENV=production

# CORS allowed frontend origin (e.g., your Vercel deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app

# Database Connection (PostgreSQL: Supabase, Render Postgres, Cloud SQL, Neon, etc.)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Session Encryption Secret
SESSION_SECRET=replace_with_a_secure_random_session_secret
