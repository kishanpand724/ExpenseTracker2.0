# ==========================================
# Expense Tracker Backend - Environment Variables
# ==========================================

PORT=3000
NODE_ENV=production

# CORS allowed frontend origin (e.g. your Vercel deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app

# PostgreSQL Database Connection
# Supported: Supabase, Render Postgres, AWS RDS, Neon, Cloud SQL, local Postgres
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Optional Supabase Connection Parameters (if not using DATABASE_URL)
SUPABASE_HOST=your-project-id.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-database-password

# Session Encryption Secret
SESSION_SECRET=replace_with_a_secure_random_session_secret
