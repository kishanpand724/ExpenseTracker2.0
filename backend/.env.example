# Database Connection (Supabase PostgreSQL / Cloud SQL)
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@[YOUR_HOST]:5432/postgres?sslmode=require

# Supabase Individual Connection Variables
SUPABASE_HOST=your-project-id.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-database-password

# Session & Security
SESSION_SECRET=your-random-session-secret-key
PORT=3000
NODE_ENV=development

# CORS Allowed Origins (Comma-separated for multiple origins, e.g., Vercel frontend URL)
CLIENT_URL=http://localhost:3000,https://your-frontend.vercel.app
